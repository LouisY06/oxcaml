{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/_build/**",
      "**/*.ml",
      "**/*.mli",
      "**/dune",
      "**/dune-project",
      "**/opam",
      "**/.git/**",
      "**/FIREBASE_*.md",
      "**/README.md",
      "**/server.log"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}

